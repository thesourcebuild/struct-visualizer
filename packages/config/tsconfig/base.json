{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "TODO: enable noUncheckedIndexedAccess once @sp/core's legacy parser is tightened (packages consume each other as source, so it must be global).",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  }
}
