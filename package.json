{
  "name": "struct-visualizer",
  "version": "0.1.5",
  "private": true,
  "packageManager": "pnpm@12.13.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@sp/web",
    "web": "pnpm --filter @sp/web dev",
    "build": "pnpm typecheck && pnpm lint && turbo run build",
    "build:pages": "pnpm --filter @sp/web build",
    "typecheck": "turbo run typecheck && tsc -p tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:print": "cross-env PRINT_LAYOUTS=1 vitest run tests/layout-golden.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "//win": "Windows launchers, build and version scripts, reachable without typing a path. They call scripts/<area>/*.bat by relative path; every .bat forwards its arguments to the matching .ps1, so `pnpm win:build:web -Clean -BasePath /repo` reaches build_web.ps1 intact. There is no `--` separator: pnpm forwards it literally and PowerShell rejects it as an ambiguous parameter name.",
    "win:web": "scripts\\launch\\launch_web.bat",
    "win:check": "scripts\\check_scripts.bat",
    "win:verify": "scripts\\build-helpers\\build_all.bat -Verify -Smoke",
    "win:build": "scripts\\build-helpers\\build_all.bat",
    "win:build:web": "scripts\\build-helpers\\build_web.bat",
    "win:version": "scripts\\package\\sync_version.bat",
    "win:clean": "scripts\\build-helpers\\clean.bat",
    "//sh": "The same launchers and builds for Linux and macOS, run through an explicit `bash` so they also work from Git Bash on Windows (pnpm runs scripts through cmd.exe there, which cannot exec a .sh). These take long flags, e.g. `pnpm sh:build:web --clean --base-path /repo`; a bare `--` is dropped by the argument parsers.",
    "sh:web": "bash scripts/launch/launch_web.sh",
    "sh:check": "bash scripts/check_scripts.sh",
    "sh:verify": "bash scripts/build-helpers/build_all.sh --verify --smoke",
    "sh:build": "bash scripts/build-helpers/build_all.sh",
    "sh:build:web": "bash scripts/build-helpers/build_web.sh",
    "sh:version": "bash scripts/package/sync_version.sh",
    "sh:clean": "bash scripts/build-helpers/clean.sh"
  },
  "devDependencies": {
    "@sp/config": "workspace:*",
    "@sp/contracts": "workspace:*",
    "@sp/core": "workspace:*",
    "@sp/engine": "workspace:*",
    "@sp/go-layout": "workspace:*",
    "@sp/layout": "workspace:*",
    "@sp/registry": "workspace:*",
    "@sp/rust-layout": "workspace:*",
    "@types/node": "^22",
    "cross-env": "^10.0.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.0"
  }
}
